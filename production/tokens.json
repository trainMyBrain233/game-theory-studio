{
  "schema_version": "1.0",
  "style": "B_clean_textbook",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "spacing": {
    "safe_margin": 84,
    "header_bottom": 116,
    "main_body_top": 332,
    "main_body_bottom": 917,
    "subtitle_divider_y": 936,
    "subtitle_baselines": [
      990,
      1043
    ],
    "graphic_text_gap_target": 24,
    "connector_text_gap_min": 8,
    "figure_name_gap": 32
  },
  "type": {
    "font_family": "GameTheory Noto Sans SC",
    "weights": [
      400,
      700
    ],
    "title": 72,
    "body": 33,
    "matrix_scores": 64,
    "main_min": 27,
    "auxiliary_identity_badge_min": 14
  },
  "motion": {
    "easing": "quintic_smoothstep",
    "title_out_seconds": 0.25,
    "title_in_seconds": 0.42,
    "text_reveal_seconds": 0.55,
    "card_flip_seconds": 0.85,
    "matrix_migration_seconds": 1.2,
    "text_transition": "out_before_in"
  },
  "identity": {
    "A": {
      "matrix": "row",
      "score_index": 0,
      "shape": "circle"
    },
    "B": {
      "matrix": "column",
      "score_index": 1,
      "shape": "square"
    }
  },
  "encoding": {
    "codec": "libx264",
    "crf": 16,
    "preset": "slow",
    "pixel_format": "yuv420p",
    "color_space": "bt709",
    "faststart": true
  },
  "colors_source": "../design/tokens.json",
  "subtitle_source": "../design/tokens.json#canvas.subtitleFont"
}
