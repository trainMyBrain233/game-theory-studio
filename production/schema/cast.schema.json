{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Theory Studio role-to-asset registry",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "actors",
    "strategies",
    "renderer_module"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "status": {
      "const": "public_source_private_layers_required"
    },
    "actors": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "allOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "object",
              "properties": {
                "identity_shape": {
                  "const": "circle"
                }
              }
            }
          ]
        },
        "B": {
          "allOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "object",
              "properties": {
                "identity_shape": {
                  "const": "square"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "strategies": {
      "type": "object",
      "required": [
        "red",
        "blue",
        "back"
      ],
      "properties": {
        "red": {
          "type": "object",
          "properties": {
            "asset": {
              "const": "assets/card_red.svg"
            }
          },
          "required": [
            "asset"
          ],
          "additionalProperties": false
        },
        "blue": {
          "type": "object",
          "properties": {
            "asset": {
              "const": "assets/card_blue.svg"
            }
          },
          "required": [
            "asset"
          ],
          "additionalProperties": false
        },
        "back": {
          "type": "object",
          "properties": {
            "asset": {
              "const": "assets/card_back.svg"
            },
            "label": {
              "type": "null"
            }
          },
          "required": [
            "asset"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "string"
    },
    "character_library": {
      "type": "object"
    },
    "renderer_module": {
      "const": "src/character_adapter.mjs"
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "asset",
        "identity_shape",
        "badge_anchor",
        "fallback_asset",
        "asset_type"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^(private_characters/pvz/assets/[ab]_head\\.png|assets/[a-z_]+\\.svg)$"
        },
        "identity_shape": {
          "enum": [
            "circle",
            "square"
          ]
        },
        "badge_anchor": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "asset_type": {
          "enum": [
            "svg",
            "raster",
            "layered_raster"
          ]
        },
        "type_name": {
          "type": "string"
        },
        "fallback_asset": {
          "type": "string",
          "pattern": "^assets/[a-z_]+\\.svg$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
