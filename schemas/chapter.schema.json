{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chapter metadata 1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "contentVersion", "stage", "visualStyle", "caseId"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "contentVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stage": {"enum": ["prototype", "audio_aligned", "rendered", "accepted"]},
    "visualStyle": {"const": "textbook"},
    "caseId": {"const": "one_round_red_blue"}
  }
}
